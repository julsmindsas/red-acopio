# ---------------------------------------------------------------------------
# Red de Acopio — variables de entorno
# Copia este archivo a `.env.local` y completa los valores que necesites.
# La app funciona SIN configurar nada (usa un store JSON local en desarrollo).
# ---------------------------------------------------------------------------

# Base de datos Postgres (Vercel Postgres / Neon).
# Si está vacía, la app usa el store JSON local (data/centers.local.json).
# En producción (Vercel) define una de estas; la integración de Neon en Vercel
# suele inyectar DATABASE_URL automáticamente.
DATABASE_URL=
POSTGRES_URL=

# API key de Google Maps JavaScript (fallback del mapa).
# OPCIONAL: si está vacía, el fallback a Google queda deshabilitado y la app
# se mantiene en Leaflet + OpenStreetMap. Debe ser una key con la
# "Maps JavaScript API" habilitada. Es pública (NEXT_PUBLIC_*), restríngela por
# dominio en la consola de Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Panel administrativo
# ---------------------------------------------------------------------------
# Contraseña del administrador. Si está vacía, el panel /admin queda DESHABILITADO.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión del admin (recomendado en producción).
# Genera uno con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# API oficial de acopiove.org (fuente híbrida)
# ---------------------------------------------------------------------------
# Fuente externa acopiove.org (terremotovenezuela.app).
#
# APAGADA POR DEFECTO desde el sismo de Chocó del 10-ago-2026: sus puntos son
# sitios en Colombia que recogen ayuda PARA VENEZUELA, así que mostrarlos en el
# mapa de esta emergencia mandaría gente a lugares que no la atienden.
#
# Ponla en "true" solo si esa red empieza a publicar puntos de la emergencia
# colombiana. El código y el snapshot persistente siguen intactos.
ACOPIO_API_ENABLED=false
ACOPIO_API_BASE=https://api.terremotovenezuela.app
ACOPIO_COUNTRY=Colombia
